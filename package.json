{
  "name": "lmnr-antigravity-plugin",
  "version": "0.3.1",
  "private": true,
  "description": "Antigravity CLI tracing for Laminar",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "esbuild src/hook.ts src/worker.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts CONTRIBUTING.md README.md VALIDATION.md package.json plugin.json hooks.json tsconfig.json .github",
    "check": "tsc --noEmit && prettier --check src scripts CONTRIBUTING.md README.md VALIDATION.md package.json plugin.json hooks.json tsconfig.json .github",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/regression.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "protobufjs": "8.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/proper-lockfile": "4.1.4",
    "esbuild": "0.25.11",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
